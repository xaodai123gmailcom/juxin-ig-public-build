# The Electron main process should generate a fresh high-entropy value on every launch.
IGAC_STARTUP_TOKEN=replace-with-at-least-32-random-characters

# Optional. Defaults to %LOCALAPPDATA%/JuxinIGCollector on Windows.
# IGAC_DATA_DIR=C:/Users/<local-user>/AppData/Local/JuxinIGCollector

IGAC_BITBROWSER_URL=http://127.0.0.1:54345
# IGAC_BITBROWSER_API_KEY=
IGAC_SESSION_HOURS=168
